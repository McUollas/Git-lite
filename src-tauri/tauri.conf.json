{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git-Lite",
  "version": "0.2.12",
  "identifier": "com.mcuollas.git-lite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Git-Lite",
        "width": 1280,
        "height": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDOTA2QzNFMDY4N0MyRjIKUldUeXdvY0dQbXlRM0FVTkRCdUtEMG5lMzR6MG5EVU1SdXM0RkxNWFdpMWNOVWpHNzBkSEYyNkYK",
      "endpoints": [
        "https://github.com/McUollas/Git-lite/releases/latest/download/latest.json"
      ]
    }
  }
}
